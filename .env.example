# Legal AI Vector Store & Dataset Environment Settings

# Paths
DATA_DIR=data
RAW_CASES_DIR=data/raw_cases
PROCESSED_CASES_DIR=data/processed_cases
READY_FOR_EMBEDDING_DIR=data/processed_cases/ready_for_embedding
METADATA_FILE=data/metadata/case_metadata.csv
CHROMA_DB_DIR=chroma_db

# HuggingFace & Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Database Configuration (Neon DB)
DATABASE_URL=your_neon_database_url_here

# Chunking Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
